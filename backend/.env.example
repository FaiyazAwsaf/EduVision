# Database Configuration (Supabase)
# Get your connection string from: Supabase Dashboard → Settings → Database → Connection pooling (URI)
# Replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL=

# ── Supabase Storage (cloud image hosting) ───────────────────────────────────
# Without these, images are stored locally (only accessible on the same machine).
# Set all three to store uploads in Supabase Storage — accessible from any device.
#
# 1. SUPABASE_URL       → Supabase Dashboard → Project Settings → API → Project URL
# 2. S3 credentials     → Supabase Dashboard → Storage → S3 Access Keys → New access key
# 3. SUPABASE_STORAGE_BUCKET → Name of the bucket you create in Supabase Storage
#                              (create it as "Public" so images load without auth)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_S3_SECRET_KEY=your-s3-secret-key
SUPABASE_STORAGE_BUCKET=script-pages

# Django Secret Key
SECRET_KEY=your-secret-key-here

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated list for production)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (if needed)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration (Phase 2)
# Google Gemini API Keys with automatic rotation support
# Configure multiple API keys for automatic quota handling
# The system will automatically rotate through available keys when quota is exceeded
# You can configure 1-10 keys (GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.)

# Primary API key
GEMINI_API_KEY_1=your-gemini-api-key-here

# Additional API keys for rotation (optional but recommended)
GEMINI_API_KEY_2=your-second-api-key-here
GEMINI_API_KEY_3=your-third-api-key-here
GEMINI_API_KEY_4=your-fourth-api-key-here

# Backward compatibility: single key (will be used if no numbered keys found)
# GEMINI_API_KEY=your-gemini-api-key-here

# Get your API key from: https://makersuite.google.com/app/apikey
